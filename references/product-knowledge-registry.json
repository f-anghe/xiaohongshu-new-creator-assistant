        "collect_value_insufficient"
      ],
      "content_positions": [
        "cover",
        "image"
      ],
      "actions": [
        "明确画面主体",
        "建立信息层级",
        "为每张图设置信息任务"
      ],
      "mechanism": "清晰的视觉主体和信息层级可以降低理解成本，并帮助用户判断是否值得点击或保存。",
      "limitations": [
        "不能使用与正文无关的画面骗取点击"
      ],
      "status": "published",
