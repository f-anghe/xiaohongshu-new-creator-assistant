            "adoption_status": {"const": "pending"}
          },
          "allOf": [
            {
              "if": {"properties": {"status": {"const": "differentiation_pending"}}, "required": ["status"]},
              "then": {"required": ["differentiation_direction"], "properties": {"user_confirmation_required": {"const": true}, "error": {"type": "null"}}}
            },
            {
              "if": {"properties": {"status": {"const": "differentiation_confirmed"}}, "required": ["status"]},
              "then": {"required": ["differentiation_direction"], "properties": {"user_confirmation_required": {"const": false}, "error": {"type": "null"}}}
            },
            {
              "if": {"properties": {"status": {"const": "demo_ready"}}, "required": ["status"]},
              "then": {
                "required": ["optimization_goal", "diagnosis", "original_copy", "demo_copy", "diffs", "keyword_suggestions", "topic_suggestions", "cover_plan", "image_plans", "change_items", "expected_metrics", "adoption_status"],
                "properties": {"adoption_status": {"const": "pending"}, "user_confirmation_required": {"const": true}, "error": {"type": "null"}}
              }
            },
            {
              "if": {"properties": {"status": {"const": "error"}}, "required": ["status"]},
              "then": {"properties": {"error": {"$ref": "#/$defs/errorObject"}}}
            }
          ]
        }
      ],
      "unevaluatedProperties": false
    },
